{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "headers": [
    { "source": "/shared-note/:path*", "headers": [{ "key": "Referrer-Policy", "value": "no-referrer" }, { "key": "Cache-Control", "value": "no-store" }] }
  ],
  "proxy": {
    "entrypoint": "middleware.js",
    "matcher": [
      "/",
      "/news",
      "/news/:categoryId/:newsId",
      "/reels",
      "/tools/shift-report",
      "/tools/revenue-report",
      "/tools/calculating-hotel-fee",
      "/sitemap.xml",
      "/rss.xml"
    ]
  }
}
